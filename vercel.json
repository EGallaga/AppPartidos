{
 "version": 2,
 "installCommand": "npm install --legacy-peer-deps",
 "builds": [
 {
 "src": "server/index.js",
 "use": "@vercel/node"
 },
 {
 "src": "appPartidos/package.json",
 "use": "@vercel/static-build",
 "config": { "distDir": "dist" }
 }
 ],
 "routes": [
 {
 "src": "/api/(.*)",
 "dest": "server/index.js"
 },
 {
 "src": "/(.*)",
 "dest": "appPartidos/$1"
 }
 ]
}